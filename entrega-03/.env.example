# Proveedor principal: anthropic | openai
LLM_PROVIDER=anthropic

# API keys (alcanza con la del proveedor principal; si cargás las dos, la otra queda de fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos (opcionales; estos son los defaults)
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6.1-sol

# Opcionales
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0

# Los embeddings son locales (HuggingFace): no necesitan API key.
