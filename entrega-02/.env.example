# Proveedor principal: openai | anthropic
LLM_PROVIDER=openai

# API keys (alcanza con la del proveedor principal; si cargás las dos, la otra queda de fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcionales; estos son los defaults)
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-opus-5-5

# Opcionales
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0
